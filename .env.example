# Copy to .env and set secure values before: docker compose up --build

# PostgreSQL (used by docker-compose db + backend)
POSTGRES_DB=inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Frontend build-time API URL (browser calls this host)
# Local Docker: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Backend CORS (comma-separated origins allowed to call the API)
# Include your deployed frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://localhost:5173
